# Ledger — environment configuration template
# Copy to .env and replace every value marked change-me before running.
# NEVER commit a real .env.

# --- Database ---
# PostgreSQL DSN for the Ledger backend.
LEDGER_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable

# --- HTTP ---
LEDGER_HTTP_ADDR=:8080
# development | production (production enables secure cookie flags, stricter logs)
LEDGER_ENV=development

# --- Auth ---
# JWT signing key (HMAC-SHA256). MUST be replaced with a real random value in any
# deployed environment: `openssl rand -base64 48`.
LEDGER_JWT_SIGNING_KEY=change-me-generate-a-real-random-key
LEDGER_ACCESS_TOKEN_TTL=15m
LEDGER_REFRESH_TOKEN_TTL=720h

# --- LLM provider (weekly narrative + clarifying-question phrasing) ---
# OpenAI-compatible chat-completions endpoint. If LEDGER_LLM_API_KEY is empty the
# narrative endpoints/worker return an explicit "LLM not configured" error rather
# than fabricating content.
LEDGER_LLM_API_KEY=
LEDGER_LLM_BASE_URL=https://api.openai.com/v1
LEDGER_LLM_MODEL=gpt-4o-mini
LEDGER_LLM_TIMEOUT=30s

# --- Ingestion ---
# Maximum accepted statement upload size (bytes).
LEDGER_MAX_STATEMENT_BYTES=10485760

# --- Rate limits (requests per minute) ---
LEDGER_RATE_LIMIT_INGEST_PER_MIN=120
LEDGER_RATE_LIMIT_USER_PER_MIN=60

# --- Worker (weekly report scheduler) ---
LEDGER_REPORT_CRON=0 6 * * 1
LEDGER_REPORT_TIMEZONE=Africa/Addis_Ababa

# --- CORS (comma-separated allowed origins for the dashboard) ---
LEDGER_CORS_ORIGINS=http://localhost:8090
